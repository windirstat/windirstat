<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<_PropertySheetDisplayName>Project-specific overrides (late)</_PropertySheetDisplayName>
		<Production Condition="'$(Production)' == ''">0</Production>
		<VersionFileFlags>0</VersionFileFlags>
		<VersionFileFlags Condition="'$(Configuration)' == 'Debug'">VS_FF_DEBUG</VersionFileFlags>
	</PropertyGroup>
	<ItemDefinitionGroup>
		<ClCompile>
			<PreprocessorDefinitions>PRODUCTION=$(Production);%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ClCompile>
		<ResourceCompile>
			<PreprocessorDefinitions>PRODUCTION=$(Production);ACTUAL_FILEFLAGS=$(VersionFileFlags);%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ResourceCompile>
	</ItemDefinitionGroup>
	<ItemDefinitionGroup Condition="'$(Configuration)'=='Release' AND '$(PlatformToolset)'!='ClangCL'">
		<Link>
			<AdditionalOptions>/release %(AdditionalOptions)</AdditionalOptions>
		</Link>
	</ItemDefinitionGroup>
	<ImportGroup Condition="'$(GitDirSentinelFile)' == ''">
		<Import Condition="Exists('$(MSBuildThisFileDirectory)GitRevision.targets')" Project="$(MSBuildThisFileDirectory)GitRevision.targets" />
	</ImportGroup>
</Project>
